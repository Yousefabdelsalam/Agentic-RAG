# Copy to .env and fill in. Nested settings use a double underscore.
APP_NAME=agentic-rag
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/v1

SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__CORS_ORIGINS=["http://localhost:3000"]

LOGGING__LEVEL=INFO
LOGGING__JSON_FORMAT=false

OPENAI__API_KEY=
OPENAI__CHAT_MODEL=gpt-4o
OPENAI__EMBEDDING_MODEL=text-embedding-3-small

CHROMA__PERSIST_DIRECTORY=./.chroma
CHROMA__COLLECTION=documents

INGESTION__CHUNK_SIZE=1000
INGESTION__CHUNK_OVERLAP=200
INGESTION__EMBED_BATCH_SIZE=128
INGESTION__UPSERT_BATCH_SIZE=256
INGESTION__MAX_CONCURRENT_BATCHES=4

RETRIEVAL__DEFAULT_SEARCH_TYPE=similarity
RETRIEVAL__TOP_K=5
RETRIEVAL__FETCH_K=20
RETRIEVAL__MMR_LAMBDA=0.5
RETRIEVAL__SCORE_THRESHOLD=0.0
RETRIEVAL__COMPRESSION_ENABLED=true
RETRIEVAL__COMPRESSION_FETCH_MULTIPLIER=3
RETRIEVAL__COMPRESSION_MAX_CHARACTERS=8000
RETRIEVAL__DENSE_WEIGHT=0.5

AGENT__MAX_REVISIONS=2
AGENT__TEMPERATURE=0.0
AGENT__MAX_CONTEXT_DOCUMENTS=8
AGENT__MIN_CONFIDENCE=0.5
AGENT__REQUEST_TIMEOUT_SECONDS=90.0

MEMORY__ENABLED=true
MEMORY__SHORT_TERM_TURNS=6
MEMORY__SUMMARY_AFTER_TURNS=6
MEMORY__MAX_USER_FACTS=20
MEMORY__MAX_SESSIONS=1000
MEMORY__EXTRACT_USER_CONTEXT=true

TOOLS__ENABLED=true
TOOLS__MAX_CALLS_PER_TURN=3
TOOLS__TIMEOUT_SECONDS=15.0

# Retries apply to transient dependency failures only, never to rejections.
RESILIENCE__RETRY_ATTEMPTS=3
RESILIENCE__RETRY_INITIAL_BACKOFF_SECONDS=0.2
RESILIENCE__RETRY_MAX_BACKOFF_SECONDS=5.0
RESILIENCE__RETRY_JITTER=0.2
# Time to first byte, not total: streaming responses are not cut off.
RESILIENCE__REQUEST_TIMEOUT_SECONDS=120.0
# Query-embedding cache. Set the size to 0 to disable.
RESILIENCE__EMBEDDING_CACHE_SIZE=512
RESILIENCE__EMBEDDING_CACHE_TTL_SECONDS=900.0

# Answer cache. Unlike every other group, these read RAG_CACHE_* directly rather
# than the nested CACHE__ form, because the names are part of the deployment
# contract. Both are accepted.
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600
RAG_CACHE_SEMANTIC_ENABLED=true
RAG_CACHE_SIMILARITY_THRESHOLD=0.92
# Entries held in the semantic index; lookup scans it linearly.
RAG_CACHE_SEMANTIC_MAX_ENTRIES=500
# Set to share the cache across replicas and restarts. Unset keeps it in-process.
# Requires the optional extra: uv sync --extra redis
RAG_CACHE_REDIS_URL=
RAG_CACHE_REDIS_TIMEOUT_SECONDS=2.0
RAG_CACHE_NAMESPACE=agentic-rag
# Derived from the chat model, the temperature, and the prompt files when unset.
# Set either one to pin it, which stops that dimension invalidating the cache.
RAG_CACHE_MODEL_VERSION=
RAG_CACHE_PROMPT_VERSION=

LANGSMITH__ENABLED=false
LANGSMITH__API_KEY=
LANGSMITH__PROJECT=agentic-rag
# configure_tracing() derives LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY /
# LANGCHAIN_PROJECT (and their LANGSMITH_* equivalents) from the settings above.
# Set them directly only when running a script that never calls create_app().

OBSERVABILITY__CAPTURE_DOCUMENTS=true
OBSERVABILITY__CAPTURE_PROMPTS=true
OBSERVABILITY__CAPTURE_ANSWERS=true
OBSERVABILITY__MAX_CAPTURED_CHARACTERS=2000
OBSERVABILITY__MAX_CAPTURED_DOCUMENTS=10
